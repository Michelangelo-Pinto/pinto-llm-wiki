# Wiki.js MCP Server (local development)
# Copy to mcp-servers/wiki-js-mcp/.env: cp config/example.env .env

# Wiki.js Instance
# Local: http://localhost:3000
WIKIJS_API_URL=http://localhost:3000
WIKIJS_TOKEN=your_jwt_token_here

# Alternative: Username/Password Authentication
# WIKIJS_USERNAME=admin@example.com
# WIKIJS_PASSWORD=your_password

# Local SQLite mappings database
WIKIJS_MCP_DB=./wikijs_mappings.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=wikijs_mcp.log

# Repository context
REPOSITORY_ROOT=./
DEFAULT_SPACE_NAME=Documentation

# MCP transport (sse for Docker/long-lived; stdio for Cursor local spawn)
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=sse
