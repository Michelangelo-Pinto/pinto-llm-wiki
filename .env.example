# Full stack (docker compose from repo root)
# Copy to .env and set values before: docker compose up -d --build

# PostgreSQL (Wiki.js)
POSTGRES_DB=wikijs
POSTGRES_USER=wikijs
POSTGRES_PASSWORD=your_secure_password_here

# Ports
WIKIJS_PORT=3000
MCP_PORT=8000
QDRANT_GRPC_PORT=6333
QDRANT_REST_PORT=6334
QDRANT_MCP_PORT=8001
INGESTION_MCP_PORT=8002
TESSERACT_MCP_PORT=8003

# Qdrant configuration
QDRANT_URL=http://qdrant-db:6334
QDRANT_COLLECTION_WIKI_PAGES=wiki_pages
QDRANT_COLLECTION_DOCUMENTS=documents

# Wiki.js site URL (used by the auto-setup service)
WIKIJS_SITE_URL=http://localhost:3000

# Wiki.js API (used by wiki-js-mcp container; http://wiki:3000 inside compose network)
WIKIJS_API_URL=http://wiki:3000

# Admin credentials — used by both the auto-setup service and the MCP server.
# On first start, the "setup" service POSTs these to Wiki.js /finalize,
# so no manual web setup is required. The MCP server logs in with the same creds.
WIKIJS_USERNAME=admin@example.com
WIKIJS_PASSWORD=your_admin_password_here

# Alternative: manual JWT token (set after completing Wiki.js web setup by hand)
# WIKIJS_TOKEN=your_jwt_token_here
